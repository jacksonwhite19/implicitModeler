"""Private diagnostic writer candidate; no installation or scientific publisher."""
import os
from pathlib import Path
from optimized_durable_json import encoded
from path_preserving_deduplication import replace_open_destination


def durable_json(path,value):
    path=Path(path);pending=path.with_name(path.name+'.pending')
    data=encoded(value)
    with pending.open('wb') as stream:
        stream.write(data);stream.flush();os.fsync(stream.fileno())
    replace_open_destination(pending,path)
