"""One pending-generator and actual-source observer control; no mesh or live parent."""
from pathlib import Path
from types import SimpleNamespace
from contextlib import ExitStack
from unittest.mock import patch
import ast,hashlib,json,sys,time
HERE=Path(__file__).resolve().parent
V4=HERE.parents[3]

def sha(path):
    with Path(path).open('rb') as stream:return hashlib.file_digest(stream,'sha256').hexdigest()
def read(path):return json.loads(Path(path).read_text(encoding='utf-8'))

def parent(selected,observed,deadline,folder):
    import fixture_study as d
    import standalone_case as case_owner
    import owned_runtime
    import numpy as np
    from sdf_cfd_mesher_v4.runtime import frozen_imports
    from sdf_cfd_mesher_v4.sdf.canonical import CanonicalKernel
    from sdf_cfd_mesher_v4.sdf.regional_owner import canonical_region_scope
    from general_sdf_authority import GeneralSdfAuthority,ManualRequirements
    from prism_host_metric import PrismMetricPolicy
    from sdf_cfd_mesher_v4.sdf.operations import positive_real_value_region
    from sdf_cfd_mesher_v4.sdf.regional import Interval
    checks=[];calls={};events=[];native_status={};refusals={}
    path_before=sys.path[:];input_scopes_before=case_owner._import_scopes.get()
    task=read(HERE/'TASK.json');record=task['pending_assignment'];assignment=read(record['path'])
    row=assignment['input_contracts']['inline_base'];cfg=read(HERE/'CONTROL_CASES.json')
    def tick():
        if time.perf_counter()>=deadline:raise TimeoutError('SharedObserverControlDeadline')
    def require(ok,label):
        tick()
        if not ok:raise AssertionError(label)
        checks.append(label)
    def rejected(label,action,message):
        try:action()
        except BaseException as error:
            require(message in str(error),(label,repr(error)))
            refusals[label]=dict(type=type(error).__name__,message=str(error));return error
        raise AssertionError('ExpectedRejection',label)
    def forbidden(*args,**kwargs):raise AssertionError('ForbiddenNumericalOwner')
    preparer=d.module('observer_connection_prepare',HERE/'prepare.py')
    activator=d.module('observer_connection_activate',HERE/'activate.py')
    observed.update(explicit_preparer=str(HERE/'prepare.py'),explicit_activator=str(HERE/'activate.py'))
    require(preparer.GENERATOR_ROOT==activator.GENERATOR_ROOT==HERE,'fixed_current_generator_root')
    prepared=folder/'prepared_request';derived=folder/'live_request'
    args=['--case',row['case_path'],'--policy',row['policy_path'],'--request-dir',str(prepared),
        '--output',str(prepared/'mesh'),'--source-manifest-sha256',sha(HERE/'PINNED_SOURCES.json'),
        '--assignment',record['path'],'--assignment-sha256',record['sha256'],'--input-contract','inline_base',
        '--maximum-faces','42000','--payload-seconds','1740','--owner-seconds','1800']
    prep=preparer.main(args)
    require(sys.path==path_before and case_owner._import_scopes.get() is input_scopes_before,'preparation_scopes_restored')
    with ExitStack() as held:
        prepared_files={str(f):sha(f) for f in prepared.rglob('*') if f.is_file()}
        for f,digest in prepared_files.items():held.enter_context(d.guard(Path(f)));require(sha(f)==digest,'held_prepared_'+Path(f).name)
        require(preparer.verify_prepared(prepared,prep['manifest_sha256'])['execution_authorized'] is False,'pending_prepared_verified')
        live=activator.main(['--prepared',str(prepared),'--prepared-manifest-sha256',prep['manifest_sha256'],
            '--destination',str(derived),'--task',record['path'],'--task-sha256',record['sha256'],'--input-contract','inline_base'])
        generated={str(f):sha(f) for f in derived.rglob('*') if f.is_file()}
        selected.update(prepared_files);selected.update(generated)
        for f,digest in generated.items():held.enter_context(d.guard(Path(f)));require(sha(f)==digest,'held_derived_'+Path(f).name)
        require(sha(derived/'PINNED_SOURCES.json')==live['manifest_sha256'],'held_generated_manifest_matches_activation')
        generated_pins=read(derived/'PINNED_SOURCES.json')
        require(all(generated_pins.get(path)==digest for path,digest in generated.items() if Path(path)!=derived/'PINNED_SOURCES.json'),'generated_files_match_held_manifest_before_import')
        run=d.module('observer_derived_entry',derived/'run.py');pending=d.module('observer_prepared_entry',prepared/'run.py')
        observed.update(generated_entry=str(derived/'run.py'),prepared_entry=str(prepared/'run.py'))
        binding=run.verify_activation();planned=run.request();live_task=read(derived/'TASK.json')
        require(binding['generator_root']==str(HERE) and binding['input_contract']==row,'actual_generator_input_binding')
        require(binding['producer_sha256']==sha(HERE/'candidate/tet_layer_handoff.py')==sha(prepared/'candidate/tet_layer_handoff.py')==sha(derived/'candidate/tet_layer_handoff.py'),'actual_observer_copied_both_bundles')
        require(all(live_task[k]==0 for k in ('maximum_invocations','payload_seconds','owner_seconds','transition_seconds')) and all(live_task[k] is None for k in ('start_utc','launch_cutoff_utc','deadline_utc')),'zero_live_null_dates')
        require(read(prepared/'STAGE_REQUEST.json')['maximum_faces']==read(derived/'STAGE_REQUEST.json')['maximum_faces']==42000,'unchanged_pending42000_capacity')
        require(planned['output']==str(derived/'live01/mesh') and planned['arguments']==read(derived/'LIVE_REQUEST.json')['arguments'],'actual_future_path_and_argv')
        for entry,label,message in ((pending,'prepared','NumericalExecutionDisabledResearchPreparation'),(run,'derived','MissingSeparateLiveGrant')):
            with patch.object(entry,'resource_scope',forbidden),patch.object(entry,'selected_main',forbidden):
                for role,argv in [('launch',[]),('coordinator',['parent','0','1']),('worker',['--worker'])]:
                    rejected(label+'_'+role,lambda argv=argv,entry=entry:entry.main(argv),message)
        original_read=run.read
        def wrong_binding(path):
            value=original_read(path)
            return dict(value,producer_sha256='0'*64) if Path(path)==derived/'ACTIVATION.json' else value
        with patch.object(run,'read',wrong_binding):rejected('simulated_wrong_producer_binding',run.verify_activation,'ChangedObserverProducerBinding')
        rejected('missing_required_closed_receipts',lambda:run.verify_required_receipts({}),'ReviewedControlReceiptsRequired')
        tree=ast.parse((derived/'run.py').read_text());verify=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='verify_required_receipts')
        required_node=next(n.value for n in verify.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='required' for t in n.targets))
        require(set(ast.literal_eval(required_node.args[0]))==set(activator.receipt_paths()+activator.current_control_receipts()+activator.observer_control_receipts()),'future_positive_gate_keeps_old_and_new_review_roots')
        for name in activator.FILES[5:-1]:
            original=(preparer.TEMPLATE/name).read_bytes()
            if name=='candidate/finite_collar_command.py':
                text=original.decode().replace('\r\n','\n')
                original=preparer.replace_once(text,'RETIREMENT=HERE.parents[1]','RETIREMENT=Path('+repr(str(preparer.R))+')').encode()
            require((derived/name).read_bytes()==original,'unchanged_helper_except_existing_path_binding_'+name)
        stage=frozen_imports._load('finite_collar_stage_adapter',derived/'stage.py');observed['generated_stage']=str(derived/'stage.py')
        try:
            pins=read(derived/'PINNED_SOURCES.json');bad=dict(pins);bad[str(derived/'candidate/tet_layer_controls.py')]='0'*64
            def wrong_source():
                with stage.selected_helpers(bad):raise AssertionError('ChangedSourceAdmitted')
            rejected('actual_wrong_helper_hash',wrong_source,'ChangedPrivateStageHelper')
            with stage.selected_helpers(pins,observed) as (helpers,require_active):
                producer=helpers['finite_stage_handoff'];import tet_layer_handoff as owner
                require(producer.fluid_owner is owner.fluid_owner and producer._issued is owner._issued and producer.TransitionInputs is owner.TransitionInputs and producer._capture is owner._capture,'generated_original_canonical_aliases')
                require(Path(owner.__file__).resolve()==V4/'tools/tet_layer_handoff.py','original_canonical_path')
                require(Path(producer.observe_fluid_call.__code__.co_filename).resolve()==derived/'candidate/tet_layer_handoff.py','actual_generated_observer_function')
                require(len(owner._issued)==0,'no_issued_transition_before')
                controls=read(row['policy_path'])['tet_transition']
                outer=lambda:tick();outer.remaining_seconds=lambda:max(0.,deadline-time.perf_counter())
                def nonlive():
                    with producer.produce(None,None,None,None,None,None,controls,None,folder/'forbidden',{},_finite_policy=read(row['policy_path']),_outer_check=outer):pass
                rejected('actual_produce_nonlive_parent',nonlive,'LiveAcceptedTetPrismInputsRequired')
                release=owned_runtime.verify_release();native=Path(cfg['native_executable']);held.enter_context(d.guard(native))
                require(selected.get(str(native))==cfg['native_executable_sha256']==sha(native),'actual_native_identity')
                host=CanonicalKernel([str(native)],timeout=max(.001,deadline-time.perf_counter()));transport=host.transport
                try:
                    geom=host.load_rhai(cfg['rhai'],cfg['metres_per_model_unit'])
                    with canonical_region_scope(geom,authenticated_executable_sha256=cfg['native_executable_sha256'],authenticated_source_sha256=cfg['kernel_source_sha256'],**cfg['proof']) as scope:
                        authority=GeneralSdfAuthority(scope,ManualRequirements(**cfg['manual']),PrismMetricPolicy(**cfg['prism_policy']))
                        origin=SimpleNamespace(provider=SimpleNamespace(binding=SimpleNamespace(authority=authority,geometry_identity=geom.identity)))
                        simulated_parent=SimpleNamespace(_open=lambda:dict(origin=origin))
                        arrays={name:np.asarray(cfg[name],dtype=float) for name in ('clear','subdivide')};cells=[dict(vertices=np.asarray([0,1,2,3],dtype=int))]
                        def invoke(mode,array,rows):
                            callbacks=[]
                            def check():tick();callbacks.append('check')
                            with authority.prism_query_scope() as stats,owner.fluid_owner(simulated_parent,check,cfg['fluid_controls'],lambda v:callbacks.append(v)) as fluid:
                                callback=fluid if mode=='baseline' else producer.observe_fluid_call(fluid,stats)
                                result=callback(array,rows)
                            return dict(science={k:v for k,v in result.items() if k!='diagnostics'},diagnostics=result.get('diagnostics'),check_count=sum(v=='check' for v in callbacks))
                        with authority.prism_query_scope() as enclosing_stats:
                            expression,scale,budgets,_=scope._batch_inputs();positive_real_value_region(expression,tuple(Interval.point(x) for x in (2.,0.,0.)),scale,precision_bits=budgets[2])
                            for name,vertices,rows in [('clear',arrays['clear'],cells),('subdivide',arrays['subdivide'],cells),('empty',arrays['clear'],[]),('isolated_again',arrays['clear'],cells)]:
                                before=invoke('baseline',vertices,rows);after=invoke('observed',vertices,rows);calls[name]=dict(baseline=before,observed=after)
                                require(before['science']==after['science'],'original_science_equal_'+name)
                                require(before['check_count']==after['check_count']==before['science']['region_queries'],'original_region_callbacks_'+name)
                                diag=after['diagnostics'];counts=diag['regional_filter_counts'];science=after['science']
                                require(diag['schema']=='V4TetFluidCallWorkload/1' and diag['status']=='completed_canonical_fluid_call' and diag['scientific_acceptance'] is False and diag['scope_exit_verified'] is False,'distinct_descriptive_schema_'+name)
                                require(all(diag[k] is None for k in ('cells_without_subdivision','maximum_region_queries_per_cell','maximum_observed_depth','exclusive_component_seconds')),'unobserved_fields_null_'+name)
                                require(counts['real_sign_requests']==science['region_queries']==counts['real_sign_filtered']+counts['real_sign_exact_fallbacks'],'actual_filter_counts_'+name)
                                require(diag['subdivisions_from_completed_cover']==(science['region_queries']-science['cells'])//2,'successful_binary_cover_'+name)
                                require(all(type(x) is int and x>=0 for x in (*counts.values(),*diag['query_scope_counts'].values())),'integer_count_deltas_'+name)
                            require(calls['subdivide']['observed']['diagnostics']['regional_filter_counts']['real_sign_filtered']>0 and calls['subdivide']['observed']['diagnostics']['regional_filter_counts']['real_sign_exact_fallbacks']>0,'actual_filter_and_exact_tiers_reached')
                            require(calls['clear']['observed']['diagnostics']['regional_filter_counts']['real_sign_requests']==calls['isolated_again']['observed']['diagnostics']['regional_filter_counts']['real_sign_requests']==1,'prior_and_repeated_call_isolation')
                        primary=TimeoutError('SimulatedPrimaryFluidCheckFailure');snapshots=[]
                        def failing_check():raise primary
                        def primary_call():
                            with authority.prism_query_scope() as stats,owner.fluid_owner(simulated_parent,failing_check,cfg['fluid_controls']) as fluid:
                                def counted_stats():snapshots.append(1);return stats()
                                wrapped=producer.observe_fluid_call(fluid,counted_stats)
                                wrapped(arrays['clear'],cells)
                        error=rejected('simulated_primary_check_failure',primary_call,'SimulatedPrimaryFluidCheckFailure')
                        require(error is primary and len(snapshots)==1,'primary_error_preserved_through_both_scope_exits_no_after_snapshot')
                        with authority.prism_query_scope() as stats,owner.fluid_owner(simulated_parent,tick,cfg['fluid_controls']) as retained:
                            retained_observer=producer.observe_fluid_call(retained,stats);retained_observer(arrays['clear'],cells)
                        rejected('observer_expired_scope',lambda:retained_observer(arrays['clear'],cells),'ExpiredGeneralQueryScope')
                        require(retained(arrays['clear'],cells)['passed'] is True,'canonical_retained_behavior_unchanged')
                finally:
