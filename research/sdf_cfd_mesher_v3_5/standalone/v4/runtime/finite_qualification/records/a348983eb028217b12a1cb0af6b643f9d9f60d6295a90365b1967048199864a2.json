                require_active();require(len(owner._issued)==0,'no_issued_transition_after')
        finally:
            for alias in ('finite_collar_stage_adapter','sdf_cfd_mesher_v4._frozen_finite_collar_stage_adapter'):sys.modules.pop(alias,None)
        require(all(sha(f)==digest for f,digest in {**prepared_files,**generated}.items()),'generated_files_preserved')
        require(not any((derived/name).exists() for name in ('AUTHORIZATION.json','LAUNCH_REVIEW.json','CLOCK.json','live01_INPUT_PINS.json','live01','live01_SCOPE')),'future_live_artifacts_absent')
    require(sys.path==path_before and case_owner._import_scopes.get() is input_scopes_before,'final_input_path_scope_restoration')
    return dict(passed=True,checks=checks,calls=calls,refusals=refusals,prepared=prep,derived=live,binding=binding,
        prepared_files=prepared_files,generated_files=generated,native_retirement=native_status,
        actual_source=dict(geometry=geom.identity,kernel_source=cfg['kernel_source_sha256'],native_sha256=sha(native),release_inventory=release['source_inventory_identity']),
        actual_preparations=1,actual_derivations=1,actual_native_hosts=1,mesh_runs=0,live_credentials=0,
        genuine_accepted_parent_producer_executed=False,positive_live_gate_executed=False,
        scope='Actual generated source selection and observer on actual source; accepted-parent producer/admission/publication only source-reviewed, unexecuted.',
        simulations=['Parent origin lookup only, not a credential','In-memory wrong producer binding','Injected primary check failure and snapshot counter'],
        resource_limit='Individual native-host job membership and peak attribution not independently observed',
        performance_claim=False)
