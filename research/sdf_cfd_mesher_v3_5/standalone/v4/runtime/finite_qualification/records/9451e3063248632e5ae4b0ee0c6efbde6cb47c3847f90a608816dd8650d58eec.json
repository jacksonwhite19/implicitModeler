"""Private producer connection; canonical lease class and registry remain owners."""
from contextlib import contextmanager, ExitStack
import json, time, os
from pathlib import Path
from optimized_durable_json import encoded
from path_preserving_deduplication import replace_open_destination
import numpy as np
from sdf_cfd_mesher_v4.common.authority import frozen, array_hash, identity, file_hash
from path_preserving_deduplication import durable_json
from immutable_state_access import guard
from finite_stage_adapter import initialize, place, admit, validate
from finite_stage_controls import variable_shape, finite_collar
from tet_layer_handoff import TransitionInputs, _issued, _capture, fluid_owner
