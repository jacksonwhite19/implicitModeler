"""One copied-generator pending readiness control; no live grant or mesh."""
from pathlib import Path
from contextlib import ExitStack
from unittest.mock import patch
from datetime import datetime,timedelta
import ast,copy,hashlib,json,sys,time
HERE=Path(__file__).resolve().parent


def parent(selected,observed,deadline,folder):
    import fixture_study as d
    import standalone_case as case_owner
    from sdf_cfd_mesher_v4.sdf import canonical
    from sdf_cfd_mesher_v4.runtime import frozen_imports
    def sha(path):
        with Path(path).open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()
    def read(path):return json.loads(Path(path).read_text())
    task=read(HERE/'TASK.json');record=task['pending_assignment'];assignment=read(record['path'])
    assert selected[record['path']]==record['sha256']==sha(record['path'])
    assert task['maximum_live_invocations']==assignment['maximum_live_invocations']==0
    row=assignment['input_contracts']['inline_base'];assert folder==HERE/'controls01'
    checks=[];events=[];counters=dict(hosts=0,queries=0,processes=0,owners=0)
    path_before=sys.path[:];scopes_before=case_owner._import_scopes.get()
    aliases=('finite_collar_stage_adapter','finite_stage_controls','finite_stage_adapter','finite_stage_background','finite_stage_command','finite_stage_handoff')
    def restored():
        assert sys.path==path_before and case_owner._import_scopes.get() is scopes_before
        assert not any(n in sys.modules or 'sdf_cfd_mesher_v4._frozen_'+n in sys.modules for n in aliases)
    def mark(name):
        if time.perf_counter()>=deadline:raise TimeoutError('ReadinessControlDeadline')
        checks.append(name)
        with (folder/'CONTROL_EVENTS.jsonl').open('a') as f:f.write(json.dumps(dict(check=name,passed=True))+'\n')
    def reject(name,fn,message):
        try:fn()
        except ValueError as error:assert message in str(error),(name,repr(error));mark(name)
        else:raise AssertionError('ExpectedRejection',name)
    def forbidden(kind):
        def stop(*a,**k):counters[kind]+=1;raise AssertionError('ForbiddenNonmeshingEntry',kind)
        return stop
    copied=folder/'generator_copy';copied.mkdir();copy_pins=dict(selected)
    for name in ('prepare.py','activate.py'):
        source=HERE/name;target=copied/name
        assert sha(source)==selected[str(source)]
        with target.open('xb') as f:f.write(source.read_bytes())
        assert sha(target)==sha(source);copy_pins[str(target)]=sha(target)
    with (copied/'PINNED_SOURCES.json').open('x') as f:json.dump(copy_pins,f,sort_keys=True,indent=2);f.write('\n')
    generator_files={str(f):sha(f) for f in copied.iterdir() if f.is_file()}
    prepared=folder/'prepared_request';derived=folder/'live_request'
    args=['--case',row['case_path'],'--policy',row['policy_path'],'--request-dir',str(prepared),
        '--output',str(prepared/'mesh'),'--source-manifest-sha256',sha(copied/'PINNED_SOURCES.json'),
        '--assignment',record['path'],'--assignment-sha256',record['sha256'],'--input-contract','inline_base',
        '--maximum-faces','42000','--payload-seconds','1740','--owner-seconds','1800']
    originals={f:sha(f) for f in (row['case_path'],row['policy_path'],record['path'])}
    loader=frozen_imports._load
    def observe(name,path):
        module=loader(name,path);actual=str(Path(module.__file__).resolve());observed[name]=actual
        events.append(dict(name=name,path=actual,sha256=sha(actual)));return module
    with ExitStack() as held:
        for f,h in generator_files.items():held.enter_context(d.guard(Path(f)));assert sha(f)==h
        preparer=d.module('copied_readiness_prepare',copied/'prepare.py')
        activator=d.module('copied_readiness_activate',copied/'activate.py')
        assert preparer.READINESS_ROOT==activator.READINESS_ROOT==HERE
        assert preparer.HERE==activator.HERE==copied
        mark('actual_byte_identical_generator_copy_and_local_manifest')
        held.enter_context(patch.object(canonical.CanonicalKernel,'__init__',forbidden('hosts')))
        if hasattr(canonical,'LineProcess'):held.enter_context(patch.object(canonical.LineProcess,'__init__',forbidden('hosts')))
        for name in ('evaluate','eval','query','query_region','describe'):
            if hasattr(canonical.CanonicalKernel,name):held.enter_context(patch.object(canonical.CanonicalKernel,name,forbidden('queries')))
        held.enter_context(patch('subprocess.Popen',forbidden('processes')))
        held.enter_context(patch.object(frozen_imports,'_load',observe))
        prep=preparer.main(args);restored()
        prep_files={str(f):sha(f) for f in prepared.rglob('*') if f.is_file()}
        for f,h in prep_files.items():held.enter_context(d.guard(Path(f)));assert sha(f)==h
        assert preparer.verify_prepared(prepared,prep['manifest_sha256'])['execution_authorized'] is False
        mark('actual_pending42000_preparation_and_verification')
        def derive(name,expected=record['sha256']):
            return activator.main(['--prepared',str(prepared),'--prepared-manifest-sha256',prep['manifest_sha256'],
                '--destination',str(folder/name),'--task',record['path'],'--task-sha256',expected,'--input-contract','inline_base'])
        live=derive('live_request');restored()
        generated={str(f):sha(f) for f in derived.rglob('*') if f.is_file()}
        for f,h in generated.items():held.enter_context(d.guard(Path(f)));assert sha(f)==h
        run=d.module('readiness_generated_binding',derived/'run.py')
        binding=run.verify_activation();planned=run.request();live_task=read(derived/'TASK.json')
        assert binding['readiness_root']==str(HERE) and binding['assignment_task_sha256']==record['sha256']
        assert binding['input_contract']==row and binding['activation_source']==str(copied/'activate.py')
        assert live_task==activator.live_task_from_assignment(assignment)
        assert all(live_task[k]==0 for k in ('maximum_invocations','payload_seconds','owner_seconds','transition_seconds'))
        assert all(live_task[k] is None for k in ('start_utc','launch_cutoff_utc','deadline_utc'))
        assert read(prepared/'STAGE_REQUEST.json')['maximum_faces']==read(derived/'STAGE_REQUEST.json')['maximum_faces']==42000
        assert Path(planned['output'])==derived/'live01'/'mesh'
        assert planned['arguments']==read(derived/'LIVE_REQUEST.json')['arguments']
        assert all((derived/n).read_bytes()==(prepared/n).read_bytes() for n in ('stage.py',*activator.FILES[5:]))
        mark('actual_derivative_assignment_capacity_identity_selector_argv_and_zero_live')
        roots=activator.current_control_receipts()
        assert roots and all(HERE in Path(f).parents for f in roots)
        assert all(copied not in Path(f).parents for f in roots)
        tree=ast.parse((derived/'run.py').read_text());helper=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='verify_required_receipts')
        required_node=next(n.value for n in helper.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='required' for t in n.targets))
        required=ast.literal_eval(required_node.args[0]);assert set(required)==set(activator.receipt_paths()+roots)
        control_node=next(n.value for n in helper.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='control' for t in n.targets))
        assert ast.literal_eval(control_node.args[0])==str(HERE)
        assert not(copied/'controls01').exists()
        mark('actual_fixed_readiness_receipt_root_after_copy')
        with patch.object(run,'resource_scope',forbidden('owners')),patch.object(run,'selected_main',forbidden('owners')):
            for role,a in [('launch',[]),('coordinator',['parent','0','1']),('worker',['--worker'])]:
                reject('actual_missing_grant_'+role,lambda a=a:run.main(a),'MissingSeparateLiveGrant')
        reject('actual_wrong_expected_assignment_hash',lambda:derive('wrong_assignment','0'*64),'ChangedReviewedAssignment')
        wrong=args[:];wrong[wrong.index('--maximum-faces')+1]='42001';wrong[wrong.index('--request-dir')+1]=str(folder/'wrong_capacity');wrong[wrong.index('--output')+1]=str(folder/'wrong_capacity/mesh')
        reject('actual_cli_capacity_mismatch',lambda:preparer.main(wrong),'CapacityArgumentAssignmentMismatch')
        reject('actual_missing_required_receipts',lambda:run.verify_required_receipts({}),'ReviewedControlReceiptsRequired')
        reject('simulated_stale_required_receipt_hash',lambda:run.verify_required_receipts({f:'0'*64 for f in required}),'ReviewedControlReceiptsRequired')
        real_read=run.read
        def changed_read(path):
            value=real_read(path)
            if Path(path) in (prepared/'STAGE_REQUEST.json',derived/'STAGE_REQUEST.json'):value=dict(value,maximum_faces=42001)
            return value
        with patch.object(run,'read',changed_read):reject('simulated_matching_wrong_caps',run.verify_activation,'CapacityAssignmentMismatch')
        def stale_read(path):
            value=real_read(path)
            return dict(value,selector='0'*64) if Path(path)==derived/'LIVE_REQUEST.json' else value
        with patch.object(run,'read',stale_read):reject('simulated_stale_selector',run.verify_activation,'ChangedActivationSelection')
        # Construction of future intent data only; no assignment/grant/review file is written.
        future=copy.deepcopy(assignment);start=datetime.fromisoformat(task['start_utc'])
        future.update(maximum_live_invocations=1,execution_authorized=True,live_payload_seconds=1740,
            live_owner_seconds=1800,live_transition_seconds=720,start_utc=start.isoformat(),
            deadline_utc=(start+timedelta(seconds=3600)).isoformat(),live_cutoff_utc=(start+timedelta(seconds=1200)).isoformat())
        assert preparer.assignment_intent(future) is activator.assignment_intent(future) is True
        future_task=activator.live_task_from_assignment(future)
        assert future_task==run.live_task_from_assignment(future) and future_task['payload_seconds']==1740
        assert future_task['owner_seconds']==1800 and future_task['transition_seconds']==720
        mark('simulated_future_one_live_task_construction_only')
        altered=dict(future,live_transition_seconds=721)
        reject('simulated_wrong_future_allowance',lambda:activator.assignment_intent(altered),'ExactAssignmentAllowancesRequired')
        altered_dates=dict(future,live_cutoff_utc=(start+timedelta(seconds=1201)).isoformat())
        reject('simulated_wrong_future_window',lambda:preparer.assignment_intent(altered_dates),'ExactFreshLiveWindowRequired')
        changed_task=dict(live_task,payload_seconds=1740)
        def altered_task_read(path):return changed_task if Path(path)==derived/'TASK.json' else real_read(path)
        with patch.object(run,'read',altered_task_read):reject('simulated_generated_task_allowance_mismatch',run.verify_activation,'ChangedAssignmentExecutionIntent')
        primary=ValueError('SimulatedPartialSetupConsumerFailure');real_load=case_owner.load
        def failed_load(path):raise primary
        with patch.object(case_owner,'load',failed_load):
            try:derive('primary_failure')
            except ValueError as error:assert error is primary
            else:raise AssertionError('PrimaryExceptionLost')
        assert case_owner.load is real_load;restored();mark('simulated_partial_setup_primary_exception_and_restoration')
        for files in (generator_files,prep_files,generated,originals):assert all(sha(f)==h for f,h in files.items())
        assert all(value==0 for value in counters.values())
        assert all(not(derived/n).exists() for n in ('AUTHORIZATION.json','LAUNCH_REVIEW.json','CLOCK.json','live01_INPUT_PINS.json','live01','live01_SCOPE','mesh'))
        mark('preserved_sources_generated_artifacts_and_zero_numerical_activity')
    restored()
    return dict(passed=True,checks=checks,actual_checks=sum(not n.startswith('simulated_') for n in checks),
        simulated_checks=sum(n.startswith('simulated_') for n in checks),prepared=prep,derived=live,binding=binding,
        generator_files=generator_files,prepared_files=prep_files,generated_files=generated,original_files=originals,
        actual_preparations=1,actual_derivations=1,actual_missing_grant_role_denials=3,source_events=events,
        tripwire_counts=counters,fixed_readiness_root=str(HERE),copied_generator=str(copied),
        simulation='simulated_* uses in-memory metadata/hash/read or primary-exception injection. Future-positive construction is not a complete grant/gate/launch test; no positive artifact is written.',
        positive_live_gate_executed=False,sdf_hosts=0,geometry_queries=0,numerical_runs=0,live_credentials=0)
