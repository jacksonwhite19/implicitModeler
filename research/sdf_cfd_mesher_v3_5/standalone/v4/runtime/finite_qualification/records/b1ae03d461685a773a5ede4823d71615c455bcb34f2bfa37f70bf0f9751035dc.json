def parent(selected,observed,deadline,folder):
    import os
    sequence=0
    with (folder/'EVENTS.jsonl').open('x',encoding='utf-8',newline='\n') as sink:
        def event(kind,**data):
            nonlocal sequence
            sequence+=1
            sink.write(json.dumps(dict(sequence=sequence,event=kind,pid=os.getpid(),perf_counter=time.perf_counter(),**data),sort_keys=True,allow_nan=False)+'\n');sink.flush()
        event('control_begin',deadline=deadline)
        try:
            result=_parent(selected,observed,deadline,folder,event)
            event('control_complete',passed=result['passed'])
            result['event_count']=sequence
            return result
        except BaseException as error:
            try:event('control_failure',error=repr(error),winerror=getattr(error,'winerror',None))
            except BaseException as evidence_error:error.add_note('Evidence sink failed: '+repr(evidence_error))
            raise
